DB_NAME=ownlog
DB_USERNAME=ownlog
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# ── 소셜 로그인 (선택) ──────────────────────────────────────────────
# ID와 SECRET이 둘 다 있는 서비스만 로그인 버튼이 보여요. 비워 두면 그 서비스는 꺼져요.
# 로컬 Redirect URI: http://localhost:5173/login/oauth2/code/{kakao|naver|google|github}
#   (반드시 5173으로 접속해서 시작해요. Vite가 /oauth2, /login/oauth2를 8080으로 넘겨 줘요)
# 실제 값은 이 파일이 아니라 .env(커밋 금지)에만 넣어요. 예전 이름(OAUTH_GOOGLE_CLIENT_ID 등)도 그대로 동작해요.
# GitHub Secrets에는 같은 이름으로 넣어요. 단 깃허브 로그인 키만 OAUTH_GITHUB_CLIENT_ID / OAUTH_GITHUB_CLIENT_SECRET
# (GitHub이 GITHUB_로 시작하는 Secret 이름을 허용하지 않아요)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 서비스 주소를 고정하고 싶을 때만 (로컬은 비워 두면 요청 주소로 계산해요)
PUBLIC_URL=
